{
  "manifest_version": 3,
  "name": "RightLingo",
  "version": "0.8.1",
  "description": "Translation, right in your context menu. 原生右键翻译。",
  "permissions": ["contextMenus", "storage", "offscreen", "clipboardWrite"],
  "host_permissions": ["https://translate.googleapis.com/*"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
